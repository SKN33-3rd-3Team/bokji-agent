GOV24_SERVICE_KEY=your_gov24_service_key_here
# 선택: data.go.kr "전국 법정동코드 전체자료" CSV 경로(시군구 코드 매핑용).
# 지정하지 않으면 시도 코드까지만 채워진다.
SIGUNGU_CODE_CSV=
LAW_OC=

# ── 인증(로그인/회원가입) ───────────────────────────────────────────
# 회원 표시이름 등 PII 암호화 키. 반드시 DB와 분리해 관리한다.
#   새 키 생성:  python src/rag_chatbot/auth/__main__.py keygen
# 비워 두면 개발용으로 .runtime/auth_dev.key 를 자동 생성한다(운영 금지).
# (cryptography 미설치 시에도 표준 라이브러리 구현으로 그대로 동작한다.)
# 원격 DB 를 팀이 공유한다면 이 키도 같은 값으로 공유해야 서로의 PII 를 읽는다.
AUTH_ENC_KEY=
# 원격 회원 DB(원격 MySQL/MariaDB 서버, 예: skn33.iptime.org). 지정하면
# SQLite 대신 여기 붙는다.
#   형식:  mysql://user:password@host:port/dbname   (mariadb:// 도 가능)
#   pip install pymysql  필요. 배포 절차는 docs/AUTH_REMOTE_DB.md.
# 비우면 아래 AUTH_DB_PATH(또는 .runtime/auth.db) SQLite 로 동작한다(기본).
AUTH_DB_URL=
# 연결 타임아웃(초). 비우면 10. 원격 DB 가 응답 없을 때 이 시간만 기다린다.
AUTH_DB_CONNECT_TIMEOUT=
# 사용자 테이블 SQLite 경로. AUTH_DB_URL 이 없을 때만 쓴다. 비우면 .runtime/auth.db.
AUTH_DB_PATH=
# 로그인 실패 잠금: 연속 실패 허용 횟수(비우면 5)와 잠금 시간(분, 비우면 15).
# 로그인에 성공하면 실패 카운터는 0으로 초기화된다.
AUTH_MAX_LOGIN_ATTEMPTS=
AUTH_LOCKOUT_MINUTES=

# N1/N5/N9/N10/N13 LLM 연동 (RunPod Serverless, 2026-08-31 기준 아직 미확정/미배포).
# 세 후보 모델(skt/A.X-4.0-Light, Qwen/Qwen3.5-9B,
# Bllossom/llama-3.2-Korean-Bllossom-3B) 중 fine-tuning해서 HuggingFace Hub에
# 올린 checkpoint를 RunPod Serverless worker가 로드하는 방식으로 서빙 예정.
# 아래 값을 안 채우면 N1/N5/N9/N10/N13은 llm_client=None으로 동작한다(규칙
# 기반/템플릿 로직만 실행, LLM 없이도 정상 동작).
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_MODEL_NAME=

# RunPod Pod(영구 GPU 인스턴스, 위 Serverless와는 다른 제품 - PROJECT_STRUCTURE.md
# 2.4절 참고). RUNPOD_POD_ID를 채우면 LLM_BACKEND 값과 무관하게 최우선으로
# 이 Pod를 쓴다(RunPod 1순위, HuggingFace 2순위 - HF_TOKEN도 채워져 있으면
# RunPod Pod 호출이 실패할 때 자동으로 HuggingFace로 폴백한다).
RUNPOD_POD_ID=
RUNPOD_POD_PORT=
RUNPOD_POD_API_KEY=

# ── FastAPI 백엔드(backend/) 전용 ────────────────────────────────────
# 프론트 개발 서버 origin(쉼표로 여러 개 가능). 비우면 기본값
# http://localhost:5173 (backend/app/core/config.py 참고).
CORS_ORIGINS=
# 로컬 http 개발은 false(기본). HTTPS로 운영 배포할 때는 반드시 true로
# 바꿔야 세션 쿠키(Secure 속성)가 브라우저에 정상 저장된다.
COOKIE_SECURE=
# 로그인 세션(session_id 쿠키) 유효기간(일). 비우면 7.
AUTH_SESSION_TTL_DAYS=

# fine-tuning 전에 "프롬프팅만으로 되는지" 먼저 확인하는 용도
# (src/rag_chatbot/service.py의 build_llm_client() - scripts/interactive_console_chat.py,
# scripts/llm_prompt_probe.py, Streamlit 등이 전부 이 함수를 통해 읽는다).
# HuggingFace Inference API를 호출한다 - RunPod와 별개로, 후보 instruct
# 모델을 그대로 불러서 테스트해볼 때만 채우면 된다.
HF_TOKEN=
# 생략하면 기본값(Bllossom 3B)을 쓴다. 팀이 현재 실사용 중인 후보 모델은
# Qwen/Qwen3.5-9B(추론형 - 아래 LLM_MAX_NEW_TOKENS/LLM_DISABLE_THINKING 참고).
LLM_MODEL_NAME=Qwen/Qwen3.5-9B
# 예전 이름(하위 호환용) - LLM_MODEL_NAME이 비어있을 때만 이 값을 본다.
# 새로 설정할 땐 위 LLM_MODEL_NAME을 쓰는 걸 권장한다.
LLM_HF_MODEL=
# 추론형 모델(Qwen3.5 계열)은 답을 쓰기 전 내부 사고에 토큰을 크게 써서
# 호출 하나가 수십 초씩 걸린다 - 기본 8192는 그 사고 길이를 감당하려는
# 값이고, 비추론형 모델을 쓰면 낮춰도 된다.
LLM_MAX_NEW_TOKENS=1024
# 1이면 provider에 "사고 과정을 끄라"고 요청한다(Qwen3 계열 chat template
# 파라미터 - HuggingFace Inference Providers 라우팅 경로에서 실제로 먹히는지
# 검증되지 않았다. 켠 뒤 체감 속도/llm_status 평균 호출 시간으로 판단할 것).
LLM_DISABLE_THINKING=1

# 프로덕션 검색은 Korean E5 768차원 색인과 동일한 provider를 사용한다.
# 테스트·오프라인 스모크에서 기존 해시 색인을 쓸 때만
# EMBEDDING_PROVIDER=hash / EMBEDDING_DIMENSION=128로 바꾼다.
EMBEDDING_PROVIDER=korean
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

BOKJI_TRACE="1"
LLM_PREFETCH_WORKERS="5"