# 인증 DB / 개발용 암호화 키 (재생성 가능, PII 포함 가능 — 추적 금지)
.runtime/auth.db
.runtime/auth.db-*
.runtime/auth_dev.key


# 수집 원본/런타임 산출물 (재생성 가능 — 매니페스트/샘플만 추적)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/subsidy_manifest.json
!data/processed/law_manifest.json
*_log.txt
*.bin

# Persistent vector indexes (재생성 가능 - scripts/reindex_korean.py)
data/vector_db/
.runtime/vector_db/
.runtime/vector_db-smoke/

